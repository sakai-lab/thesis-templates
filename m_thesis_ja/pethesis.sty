% Based on pethesis.sty v1.3.1 (2013), Takashi Michikawa,
% with the original Waseda laboratory adaptations (2023).
\NeedsTeXFormat{LaTeX2e}[2021-06-01]
\ProvidesPackage{pethesis}[2026/09/08 v2.1 Japanese master's thesis]
\@ifclassloaded{jsbook}{}{\PackageError{pethesis}{Use the jsbook class}{This style requires pLaTeX and jsbook.}}
\RequirePackage{fancyhdr}
\RequirePackage{fancybox}
\RequirePackage[T1]{fontenc}
% Preserve the original Times/Helvetica/Courier text font choices.
\renewcommand{\rmdefault}{ptm}
\renewcommand{\sfdefault}{phv}
\renewcommand{\ttdefault}{pcr}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{etoolbox}
% Explicit, portable Japanese font embedding, without host-specific paths.
\RequirePackage[haranoaji]{pxchfon}
\renewcommand{\bibname}{参考文献}

% Preserve the physical text area and offsets of the original template.
% jsbook's 12pt option uses magnification: retain true units here.
\setlength{\hoffset}{0truemm}
\setlength{\voffset}{0truemm}
\setlength{\textwidth}{166truemm}
\setlength{\textheight}{244truemm}
\setlength{\oddsidemargin}{-3.4truemm}
\setlength{\evensidemargin}{-3.4truemm}
\setlength{\topmargin}{-16.4truemm}
% jsbook normally places page numbers in the header, leaving footskip zero.
% This template uses a footer: reserve a physical gap below the text area.
\setlength{\footskip}{10truemm}

\newcommand{\pethesis@field}[1]{%
  \expandafter\gdef\csname @#1\endcsname{}%
  \expandafter\newcommand\csname #1\endcsname[1]{%
    \expandafter\gdef\csname @#1\endcsname{##1}}}
\forcsvlist{\pethesis@field}{etitle,studentid,supervisor,affiliation,researchname,submitdate,thesistype}
\newcommand{\pethesis@required}[1]{%
  \expandafter\ifx\csname @#1\endcsname\@empty
    \PackageError{pethesis}{Missing required field: #1}{Set the #1 command in mthesis.tex before maketitle.}%
  \fi}
\def\triplebox{\VerbBox\@triplebox}
\def\@triplebox#1{%
  \begingroup
    \setbox\@fancybox\hbox{{#1}}%
    \fboxrule=.75\fboxrule
    \setbox\@fancybox\hbox{\fbox{\box\@fancybox}}%
    \fboxrule=2\fboxrule
    \fboxsep=\fboxrule
    \advance\fboxsep .5pt
    \fbox{\setlength{\fboxrule}{.9mm}\fbox{\box\@fancybox}}
  \endgroup}
  

% Optional fine adjustment retained for existing cover configurations.
\newcommand{\adjustspace}[1]{\def\@adjustspace{#1}}
\adjustspace{0pt}
\renewcommand{\maketitle}{%
  \forcsvlist{\pethesis@required}{title,etitle,author,studentid,supervisor,affiliation,researchname,submitdate,thesistype}%
  \clearpage\thispagestyle{empty}
  \fancypage{\triplebox}{}
  \noindent\vbox to .98\textheight{%
    \hsize=\textwidth\centering
    \vspace*{8truemm}
    {\gtfamily\fontsize{16truept}{20truept}\selectfont\@thesistype\par}
    \vspace{5truemm}
    \includegraphics[width=48truemm]{waseda_logo.pdf}\par
    \vspace{12truemm}
    {\gtfamily\fontsize{26truept}{30truept}\selectfont\@title\par}
    \vspace{8truemm}
    {\rmfamily\fontsize{18truept}{22truept}\selectfont\@etitle\par}
    \vfill\vspace{\@adjustspace}
    {\fontsize{16truept}{20truept}\selectfont 指導教員\quad\@supervisor\par}
    \vspace{4truemm}
    {\fontsize{14truept}{18truept}\selectfont 研究指導名\quad\@researchname\par}
    \vspace{10truemm}
    {\fontsize{14truept}{18truept}\selectfont\@affiliation\par}
    \vspace{6truemm}
    {\fontsize{16truept}{20truept}\selectfont 学籍番号\quad\@studentid\par}
    \vspace{6truemm}
    {\fontsize{20truept}{24truept}\selectfont\@author\par}
    \vspace{6truemm}
    {\fontsize{16truept}{20truept}\selectfont 提出日\quad\@submitdate\par}
    \vspace{8truemm}}
  \par\clearpage
  \fancypage{}{}% Stop the cover frame before the abstract.
}

% Allow the abstract to flow across pages; keep its unnumbered appearance.
\newenvironment{coverabstract}{%
  \clearpage\pagestyle{empty}\thispagestyle{empty}
  \vspace*{40truemm}
  \begin{center}\bfseries 概要\end{center}
  \ignorespaces
}{\par\clearpage}

% Ordinary pages retain alternating headers; opening pages show only a footer.
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\nouppercase{\leftmark}}
\fancyhead[RO]{\small\nouppercase{\rightmark}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{.4pt}
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\chaptermark}[1]{%
  \markboth{\ifnum\c@secnumdepth>\m@ne\if@mainmatter
    \@chapapp\thechapter\@chappos\quad\fi\fi #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\quad #1}}
% A dedicated opening-page style applies to numbered and unnumbered chapters.
\fancypagestyle{thesischapter}{%
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}}
% Patch only the page style; keep the current jsbook chapter implementation.
\patchcmd{\chapter}{\plainifnotempty}{\thispagestyle{thesischapter}}{}{%
  \PackageError{pethesis}{Cannot set chapter-opening page style}{The jsbook chapter implementation has changed.}}

% jsbook already adds References to the TOC; use its bibliography unchanged.
\newenvironment{acknowledgement}{%
  \chapter*{謝辞}
  \markboth{謝辞}{謝辞}
  \addcontentsline{toc}{chapter}{謝辞}
}{\par}

\def\@makechapterhead#1{
\vspace*{2\Cvs}
{\parindent \z@ \raggedright \normalfont
\Huge\headfont
\ifnum \c@secnumdepth >\m@ne
\if@mainmatter
\@chapapp\thechapter\@chappos
\hskip1zw
\fi
\fi
#1\par\nobreak
\vskip 3\Cvs}}

% The maintained jsbook implementation supplies the TOC and bibliography.
\setcounter{tocdepth}{2}
\renewcommand{\@dotsep}{1}

% Existing shorthand retained for authors migrating from the old template.
\newcommand{\insertfigure}[4]{%
  \begin{figure}[H]\centering
    \includegraphics[#4]{#1}
    \caption{#2}\label{#3}
  \end{figure}}
