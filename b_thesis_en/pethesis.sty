% Based on pethesis.sty v1.3.1 (2013), Takashi Michikawa,
% with the original Waseda laboratory adaptations.
\NeedsTeXFormat{LaTeX2e}[2021-06-01]
\ProvidesPackage{pethesis}[2026/09/08 v2.1 English undergraduate thesis]
\@ifclassloaded{jsbook}{}{\PackageError{pethesis}{Use the jsbook class}{This style requires pLaTeX and jsbook.}}
\RequirePackage{fancyhdr}
\RequirePackage{fancybox}
\RequirePackage[T1]{fontenc}
\RequirePackage[scaled=.90]{helvet}
% Retain the undergraduate template's Times and Courier text fonts.
\renewcommand{\rmdefault}{ptm}
\renewcommand{\ttdefault}{pcr}
\RequirePackage{graphicx}
\RequirePackage{etoolbox}
\renewcommand{\headfont}{\normalfont\rmfamily\bfseries}
\renewcommand{\contentsname}{Contents}
\renewcommand{\listfigurename}{List of Figures}
\renewcommand{\listtablename}{List of Tables}
\renewcommand{\figurename}{Fig.\space}
\renewcommand{\tablename}{Table\space}
\renewcommand{\bibname}{References}
\renewcommand{\appendixname}{Appendix\space}
\renewcommand{\prechaptername}{Chapter\space}
\renewcommand{\postchaptername}{}

% Preserve the physical text area and offsets of the original template.
% jsbook's 12pt option uses magnification: retain true units here.
\setlength{\hoffset}{0truemm}
\setlength{\voffset}{0truemm}
\setlength{\textwidth}{166truemm}
\setlength{\textheight}{244truemm}
\setlength{\oddsidemargin}{-3.4truemm}
\setlength{\evensidemargin}{-3.4truemm}
\setlength{\topmargin}{-16.4truemm}
% jsbook normally places page numbers in the header, leaving footskip zero.
% This template uses a footer: reserve a physical gap below the text area.
\setlength{\footskip}{10truemm}

% Cover values are supplied by the author in bthesis.tex.
\newcommand{\pethesis@field}[1]{%
  \expandafter\gdef\csname @#1\endcsname{}%
  \expandafter\newcommand\csname #1\endcsname[1]{%
    \expandafter\gdef\csname @#1\endcsname{##1}}}
\forcsvlist{\pethesis@field}{studentid,supervisor,affiliation,thesistype}
\newcommand{\pethesis@required}[1]{%
  \expandafter\ifx\csname @#1\endcsname\@empty
    \PackageError{pethesis}{Missing required field: #1}{Set the #1 command in bthesis.tex before maketitle.}%
  \fi}
\def\triplebox{\VerbBox\@triplebox}
\def\@triplebox#1{%
  \begingroup
    \setbox\@fancybox\hbox{{#1}}%
    \fboxrule=.75\fboxrule
    \setbox\@fancybox\hbox{\fbox{\box\@fancybox}}%
    \fboxrule=2\fboxrule
    \fboxsep=\fboxrule
    \advance\fboxsep .5pt
    \fbox{\setlength{\fboxrule}{.9mm}\fbox{\box\@fancybox}}
  \endgroup}


% Optional fine adjustment retained for existing cover configurations.
\newcommand{\adjustspace}[1]{\def\@adjustspace{#1}}
\adjustspace{0pt}
\renewcommand{\maketitle}{%
  \forcsvlist{\pethesis@required}{title,author,studentid,supervisor,affiliation,thesistype}%
  \clearpage\thispagestyle{empty}
  \fancypage{\triplebox}{}
  \noindent\vbox to .98\textheight{%
    \hsize=\textwidth\centering
    \vspace*{8truemm}
    {\rmfamily\fontsize{16truept}{20truept}\selectfont\@thesistype\par}
    \vspace{5truemm}
    \includegraphics[width=48truemm]{waseda_logo.pdf}\par
    \vspace{12truemm}
    {\rmfamily\fontsize{26truept}{30truept}\selectfont\@title\par}

    \vfill\vspace{\@adjustspace}
    {\fontsize{18truept}{22truept}\selectfont Supervisor:\quad\@supervisor\par}
    \vspace{10truemm}
    {\fontsize{16truept}{20truept}\selectfont\@affiliation\par}
    \vspace{6truemm}
    {\fontsize{16truept}{20truept}\selectfont Student ID:\quad\@studentid\par}
    \vspace{6truemm}
    {\fontsize{20truept}{24truept}\selectfont\@author\par}
    \vspace{8truemm}}
  \par\clearpage
  \fancypage{}{}% Stop the cover frame before the abstract.
}

% Normal paragraph flow allows abstracts longer than one page.
\newenvironment{coverabstract}{%
  \clearpage\pagestyle{empty}\thispagestyle{empty}%
  \vspace*{40truemm}
  \begin{center}\bfseries\large Abstract\end{center}
  \noindent\ignorespaces
}{\par\clearpage}

% Ordinary pages retain alternating headers; opening pages show only a footer.
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\nouppercase{\leftmark}}
\fancyhead[RO]{\small\nouppercase{\rightmark}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{.4pt}
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\chaptermark}[1]{%
  \markboth{\ifnum\c@secnumdepth>\m@ne\if@mainmatter
    \@chapapp\space\thechapter\quad\fi\fi #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\quad #1}}
% A dedicated opening-page style applies to numbered and unnumbered chapters.
\fancypagestyle{thesischapter}{%
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}}
% Patch only the page style; keep the current jsbook chapter implementation.
\patchcmd{\chapter}{\plainifnotempty}{\thispagestyle{thesischapter}}{}{%
  \PackageError{pethesis}{Cannot set chapter-opening page style}{The jsbook chapter implementation has changed.}}

% jsbook already adds References to the TOC; use its bibliography unchanged.
\newenvironment{acknowledgement}{%
  \chapter*{Acknowledgements}
  \markboth{Acknowledgements}{Acknowledgements}
  \addcontentsline{toc}{chapter}{Acknowledgements}
}{\par}

\renewcommand{\section}{\@startsection{section}{1}{\z@}%
   {.6\Cvs \@plus.2\Cdp \@minus.2\Cdp}%
   {.1\Cvs \@plus.1\Cdp}%
   {\reset@font\large\bfseries}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
   {0.2\Cvs \@plus.05\Cdp \@minus.1\Cdp}%
   {0.01\Cvs \@plus.01\Cdp}%
   {\reset@font\normalsize\bfseries}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
   {0.15\Cvs \@plus.1\Cdp \@minus.1\Cdp}%
   {0.01\Cvs \@plus.01\Cdp}%
   {\reset@font\normalsize\bfseries}}
\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}%
   {1.5ex \@plus .2ex \@minus .2ex}%
   {-1em}%
   {\reset@font\normalsize\bfseries}}
\renewcommand{\subparagraph}{\@startsection{subparagraph}{5}{\z@}%
   {1.5ex \@plus .2ex \@minus .2ex}%
   {-1em}%
   {\reset@font\normalsize\bfseries}}



\def\@makechapterhead#1{
\vspace*{2\Cvs}
{\parindent \z@ \raggedright \normalfont
\huge \bfseries \headfont
\ifnum \c@secnumdepth >\m@ne
\if@mainmatter
\@chapapp\thechapter\@chappos
\quad
\fi
\fi
\bigbreak
#1\par\nobreak
\vskip 2\Cvs}}

% Use the maintained class's TOC implementation (no tocstyle dependency).
\setcounter{tocdepth}{2}
\renewcommand{\@dotsep}{1}
